# =============================================================================
# HM1K Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control - it contains secrets!
# =============================================================================

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="CHANGE_ME_generate_a_random_key"

# SSL Certificate Info (used for self-signed cert generation)
COUNTRY_NAME="US"
STATE_OR_PROVINCE_NAME="YourState"
LOCALITY_NAME="YourCity"
ORGANIZATION_NAME="Your Organization"
COMMON_NAME="localhost"

# Admin credentials (password hash generated with bcrypt)
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2b$12$CHANGE_ME_generate_a_bcrypt_hash"

# =============================================================================
# LLM Server Integration
# =============================================================================
# Supports both Ollama API and OpenAI-compatible APIs (LM Studio, vLLM, etc.)
# The API type is auto-detected when connecting to each server.
#
# OLLAMA_ENABLED: Master switch for all LLM features
# OLLAMA_TIMEOUT: Request timeout in seconds (set high for slow models)

OLLAMA_ENABLED="false"
OLLAMA_TIMEOUT="1200"

# Primary LLM Server (required if OLLAMA_ENABLED=true)
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_PRIMARY_NAME="Local Ollama"
# OLLAMA_PRIMARY_DESC="Local LLM server"
# OLLAMA_PRIMARY_HARDWARE="Your hardware specs"

# Secondary LLM Server (optional)
# OLLAMA_SECONDARY_HOST="http://server2:11434"
# OLLAMA_SECONDARY_NAME="Secondary Server"
# OLLAMA_SECONDARY_DESC="Description"
# OLLAMA_SECONDARY_HARDWARE="Hardware specs"

# Tertiary LLM Server (optional)
# OLLAMA_TERTIARY_HOST="http://server3:1234"
# OLLAMA_TERTIARY_NAME="Tertiary Server"
# OLLAMA_TERTIARY_DESC="Description"
# OLLAMA_TERTIARY_HARDWARE="Hardware specs"

# AI Pipeline Configuration
AI_PIPELINE_DEBUG="false"

# Default file paths for testing (optional, pre-populates form fields)
# DEFAULT_ADD_JSON_PATH="/path/to/test/example_ADD.json"
# DEFAULT_POTFILE_PATH="/path/to/test/example.potfile"

# =============================================================================
# Have I Been Pwned (HIBP) Integration
# =============================================================================
# The HIBP Pwned Passwords API is enabled by default (no API key required).
# Uses k-Anonymity: only first 5 characters of hashes are sent to the API.
#
# Local Database Support (for air-gapped environments or faster lookups):
# Download the NTLM database from: https://haveibeenpwned.com/Passwords
# Set the path to your pwnedpasswords-ntlm-ordered-by-hash.txt file below.

# HIBP_LOCAL_DB_PATH="/data/hibp/pwnedpasswords-ntlm-ordered-by-hash.txt"

# API Parallelism: Number of concurrent threads for HIBP API requests.
# Default: 200. For large datasets try 500-1000. For constrained systems try 50-100.
HIBP_API_WORKERS="200"

# =============================================================================
# Advanced Options
# =============================================================================

# Enable advanced/experimental tools
ADVANCED_OPTIONS_ENABLED="false"

# Local File Browser Security Configuration
# Comma-separated list of directory paths that users can access via the file browser.
# Linux default: /home/    Windows default: C:\Users\
LOCAL_FILE_ALLOWED_PATHS="/home/"

# =============================================================================
# Multi-User Mode
# =============================================================================
# Enable to allow multiple user accounts with different roles and permissions.
# When enabled, the ADMIN_USERNAME/ADMIN_PASSWORD_HASH above becomes the superadmin.

MULTI_USER_ENABLED="false"
MULTI_USER_FILE="data/users.json"

# Roles:
#   - superadmin: Full access + user management (defined in .env, cannot be deleted)
#   - admin: Full access to all features and advanced pages
#   - user: Basic access, own sessions only, no advanced pages

# =============================================================================
# Master Potfile
# =============================================================================
# WARNING: Enabling this stores cracked passwords long-term on the server.
# When enabled, all NTLM hashes from uploaded potfiles are merged into a central
# master potfile for hash-to-password matching across sessions.

MASTER_POTFILE_ENABLED="false"
MASTER_POTFILE_PATH="data/master.potfile"

# Master potfile access for regular users (only applies when MULTI_USER_ENABLED)
MASTER_POTFILE_USER_ACCESS="true"
