[Unit]
Description=Hash Master 1000 - Password Audit Analysis Tool
After=network.target

[Service]
Type=notify
# User and group to run as (change to your user or create dedicated 'hm1k' user)
User=njoyzrd
Group=njoyzrd

# Working directory
WorkingDirectory=/home/njoyzrd/Projects/hm1k

# Virtual environment Python and Gunicorn
Environment="PATH=/home/njoyzrd/Projects/hm1k/.venv/bin"
ExecStart=/home/njoyzrd/Projects/hm1k/.venv/bin/gunicorn -c gunicorn.conf.py hm1k:app

# Restart policy
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hm1k

# Security hardening (optional - adjust as needed)
# PrivateTmp=true
# NoNewPrivileges=true
# ProtectSystem=strict
# ProtectHome=read-only
# ReadWritePaths=/home/njoyzrd/Projects/hm1k/data /home/njoyzrd/Projects/hm1k/logs

[Install]
WantedBy=multi-user.target
