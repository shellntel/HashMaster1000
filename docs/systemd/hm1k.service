[Unit]
Description=Hash Master 1000 - Password Audit Analysis Tool
After=network.target

[Service]
Type=simple
# User and group to run as
# Option 1: Create dedicated 'hm1k' user: sudo useradd -r -s /bin/false -d /opt/hm1k hm1k
# Option 2: Change to your username
User=hm1k
Group=hm1k

# Working directory - change to your HM1K installation path
WorkingDirectory=/opt/hm1k

# Virtual environment Python and Gunicorn - update paths to match your installation
Environment="PATH=/opt/hm1k/.venv/bin"
# SSL is handled by nginx reverse proxy, so disable gunicorn SSL
Environment="HM1K_SSL=false"
# Production server worker count (default caps at 8 for portability)
Environment="HM1K_WORKERS=12"
ExecStart=/opt/hm1k/.venv/bin/gunicorn -c gunicorn.conf.py hm1k:app

# Restart policy
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hm1k

# Security hardening (optional - adjust as needed)
# PrivateTmp=true
# NoNewPrivileges=true
# ProtectSystem=strict
# ProtectHome=read-only
# ReadWritePaths=/opt/hm1k/data /opt/hm1k/logs

[Install]
WantedBy=multi-user.target
