SECRET_KEY="your-secret-key-here"
COUNTRY_NAME="US"
STATE_OR_PROVINCE_NAME="YourState"
LOCALITY_NAME="YourCity"
ORGANIZATION_NAME="Your Organization"
COMMON_NAME="localhost"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="your-bcrypt-hash-here"  # Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"

# Ollama AI Integration (Optional - Hidden Feature)
# OLLAMA_ENABLED="false"
# OLLAMA_TIMEOUT="120"

# Primary Ollama Server (required if OLLAMA_ENABLED=true)
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_PRIMARY_NAME="Mac Studio"
# OLLAMA_PRIMARY_DESC="Apple Silicon with unified memory"
# OLLAMA_PRIMARY_HARDWARE="M2 Ultra, 128GB RAM"

# Secondary Ollama Server (optional)
# OLLAMA_SECONDARY_HOST="http://192.168.12.5:11434"
# OLLAMA_SECONDARY_NAME="Gaming PC"
# OLLAMA_SECONDARY_DESC="NVIDIA GPU server"
# OLLAMA_SECONDARY_HARDWARE="RTX 4090, 24GB VRAM"

# Tertiary Ollama Server (optional)
# OLLAMA_TERTIARY_HOST=""
# OLLAMA_TERTIARY_NAME=""
# OLLAMA_TERTIARY_DESC=""
# OLLAMA_TERTIARY_HARDWARE=""
