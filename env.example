# =============================================================================
# Hash Master 1000 Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# On first startup, SECRET_KEY will be auto-generated if not set.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings (Required)
# -----------------------------------------------------------------------------
SECRET_KEY="your-secret-key-here"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="your-bcrypt-hash-here"

# Generate a password hash with:
#   Linux/macOS: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
#   Windows:     python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"

# -----------------------------------------------------------------------------
# SSL Certificate Settings (used by generate_cert.py)
# -----------------------------------------------------------------------------
COUNTRY_NAME="US"
STATE_OR_PROVINCE_NAME="YourState"
LOCALITY_NAME="YourCity"
ORGANIZATION_NAME="Your Organization"
COMMON_NAME="localhost"

# -----------------------------------------------------------------------------
# Default File Paths (Optional - pre-populates form fields)
# -----------------------------------------------------------------------------
# Use forward slashes (/) on all platforms, or escaped backslashes (\\) on Windows.
#
# Linux/macOS examples:
# DEFAULT_PWDUMP_PATH="/home/user/hashes/domain.ntds"
# DEFAULT_POTFILE_PATH="/home/user/hashcat/hashcat.potfile"
# DEFAULT_ADD_JSON_PATH="/home/user/data/domain.json"
#
# Windows examples:
# DEFAULT_PWDUMP_PATH="C:/Users/user/hashes/domain.ntds"
# DEFAULT_POTFILE_PATH="C:/Users/user/hashcat/hashcat.potfile"
# DEFAULT_ADD_JSON_PATH="C:/Users/user/data/domain.json"

# -----------------------------------------------------------------------------
# Have I Been Pwned (HIBP) Integration
# -----------------------------------------------------------------------------
# The HIBP Pwned Passwords API is enabled by default (no API key required).
# Uses k-Anonymity: only first 5 characters of hashes are sent to the API.
#
# Local HIBP Database (recommended for large datasets and air-gapped environments):
# Download the full HIBP NTLM database (~16GB, 850M+ hashes) using the
# built-in downloader at /hibp/download, or manually from haveibeenpwned.com.
# Once configured, breach checks use local lookups instead of API calls.
#
# HIBP_LOCAL_DB_PATH="data/pwnedpasswords-ntlm.txt"

# -----------------------------------------------------------------------------
# Master Potfile Configuration
# -----------------------------------------------------------------------------
# WARNING: Enabling this stores cracked passwords long-term on the server.
# When enabled, all NTLM hashes from uploaded potfiles are merged into a central
# master potfile. The master potfile is then used for hash-to-password matching,
# allowing accumulated cracked passwords to be applied to new hash dumps.
#
# MASTER_POTFILE_ENABLED="false"
# MASTER_POTFILE_PATH="data/master.potfile"

# -----------------------------------------------------------------------------
# Multi-User Mode Configuration
# -----------------------------------------------------------------------------
# Enable this to allow multiple user accounts with different roles and permissions.
# When enabled, the ADMIN_USERNAME/ADMIN_PASSWORD_HASH above becomes the superadmin.
# Additional users are stored in a separate JSON file and managed via the web UI.
#
# MULTI_USER_ENABLED="false"
# MULTI_USER_FILE="data/users.json"
#
# Roles:
#   - superadmin: Full access + user management (defined in .env, cannot be deleted)
#   - admin: Full access to all features and advanced pages
#   - user: Basic access, own sessions only, no advanced pages
#
# Master potfile access for regular users (only applies when MULTI_USER_ENABLED)
# Set to "false" to restrict master potfile access to admins only.
# MASTER_POTFILE_USER_ACCESS="true"

# -----------------------------------------------------------------------------
# Advanced Options (Experimental Tools)
# -----------------------------------------------------------------------------
# When enabled, shows an "Advanced" button in the header that links to
# experimental AI tools and development utilities (/hiddenpages).
# NOTE: In multi-user mode, this is controlled by user roles instead.
#
# ADVANCED_OPTIONS_ENABLED="false"

# -----------------------------------------------------------------------------
# Local File Browser Security Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of directory paths that users can access via the file browser.
# For security, only paths starting with these prefixes will be accessible.
#
# Linux/macOS example (default):
# LOCAL_FILE_ALLOWED_PATHS="/home/"
#
# Windows example:
# LOCAL_FILE_ALLOWED_PATHS="C:/Users/,D:/HashData/"
#
# Mixed environment example:
# LOCAL_FILE_ALLOWED_PATHS="/home/,C:/Users/"

# -----------------------------------------------------------------------------
# Ollama AI Integration (Optional - Hidden Feature)
# -----------------------------------------------------------------------------
# OLLAMA_ENABLED="false"
# OLLAMA_TIMEOUT="120"

# Primary Ollama Server (required if OLLAMA_ENABLED=true)
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_PRIMARY_NAME="Mac Studio"
# OLLAMA_PRIMARY_DESC="Apple Silicon with unified memory"
# OLLAMA_PRIMARY_HARDWARE="M2 Ultra, 128GB RAM"

# Secondary Ollama Server (optional)
# OLLAMA_SECONDARY_HOST="http://192.168.12.5:11434"
# OLLAMA_SECONDARY_NAME="Gaming PC"
# OLLAMA_SECONDARY_DESC="NVIDIA GPU server"
# OLLAMA_SECONDARY_HARDWARE="RTX 4090, 24GB VRAM"

# Tertiary Ollama Server (optional)
# OLLAMA_TERTIARY_HOST=""
# OLLAMA_TERTIARY_NAME=""
# OLLAMA_TERTIARY_DESC=""
# OLLAMA_TERTIARY_HARDWARE=""

# AI Pipeline Configuration
# AI_PIPELINE_DEBUG="false"  # Set to "true" to save intermediate files at each pipeline phase
